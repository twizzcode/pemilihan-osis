# ---------------------------------------------------------------------------
# Contoh konfigurasi. Di server, salin file ini menjadi `.env`:
#   cp .env.example .env
# Lalu isi SESSION_SECRET.
# ---------------------------------------------------------------------------

# WAJIB: rahasia untuk menandatangani cookie sesi. Ganti dengan string acak.
#   Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Lokasi file database SQLite.
# Arahkan ke LUAR folder deploy agar tidak terhapus saat rsync --delete.
DATABASE_PATH=/var/lib/pilkospapi/data.db

# Folder penyimpanan foto paslon.
# Arahkan ke LUAR folder deploy agar tidak terhapus saat rsync --delete.
STORAGE_DIR=/var/lib/pilkospapi/storage

# Wajib di server. Membuat cookie session pakai flag "secure" (butuh HTTPS).
NODE_ENV=production

# Opsional: URL publik untuk metadata OpenGraph/social share.
# NEXT_PUBLIC_SITE_URL=https://domainmu.com

# Opsional: port server (default 3000).
# PORT=3000
