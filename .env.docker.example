# Copy this file to `.env` next to docker-compose.yml on the VPS, then fill in.
# Docker Compose automatically reads `.env` in the same directory.

# REQUIRED: secret used to sign session cookies. Use a long random string.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Host port to expose the app on. Container always listens on 3000 internally.
APP_PORT=3100

# Image tag to deploy. Use `latest` or pin to a commit sha / version.
IMAGE_TAG=latest

# Public base URL, used for metadata (OpenGraph) absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
